<Window
    x:Class="WindowsEdgeLight.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WindowsEdgeLight"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows Edge Light"
    Width="1"
    Height="1"
    KeyDown="Window_KeyDown"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="True"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="Windows Edge Light - Right-click for options" />
    </Window.TaskbarItemInfo>

    <!--
        Intentionally empty and pinned to 1x1px. This window no longer renders the glow
        itself - it exists only to host the hwnd used for global hotkeys, the mouse hook,
        and DPI/monitor tracking. The actual glow is drawn by a NativeLayeredWindow (see
        MainWindow.xaml.cs and NativeLayeredWindow.cs), a raw Win32 layered window managed
        entirely outside WPF.

        Deliberately NOT AllowsTransparency/Topmost/monitor-sized anymore: a WPF window
        that covers a whole monitor receives (and fully processes through WPF's own
        input/hit-testing pipeline) every single mouse-move message on that monitor, even
        with empty content and IsHitTestVisible="False" on its children - that pipeline
        cost is real even when nothing is drawn, and was making cursor movement sluggish
        on whichever monitor this window covered. Kept to 1x1px so it never intercepts
        real screen area; see PositionMainWindowShell in MainWindow.xaml.cs.
    -->
    <Grid x:Name="MainGrid" IsHitTestVisible="False" />
</Window>
